FROM golang:1.26-alpine

RUN apk add --no-cache git

WORKDIR /src
# Build context is the repository root so the shared contract module referenced
# by the `replace` directive in services/api/go.mod is available.
COPY pkg/contract ./pkg/contract
COPY services/api ./services/api

WORKDIR /src/services/api
RUN go mod download

CMD ["go", "test", "-count=1", "-v", "./tests/integration/..."]
