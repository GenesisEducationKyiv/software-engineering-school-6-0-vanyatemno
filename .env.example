# This single .env file is shared by both services in the cluster (the API and
# the notifications service). Each reads only the variables it needs.

# -- API service ----------------------------------------
# Database connection string (use your hosted DB host/port)
DB_DSN=host=postgres user=postgres password=postgres dbname=gh-subscriptions port=5432 sslmode=disable

# Server
SERVER_PORT=8080
SERVER_API_KEY=your_api_key_here

# GitHub
GITHUB_TOKEN=your_github_token

# Cron
CRON_REPO_CHECK_SCHEDULE=0 * * * *

# Frontend URL (used to build confirmation/unsubscribe links in payloads)
FRONTEND_URL=

# -- Notifications service ------------------------------
# Mailer (SMTP) — consumed by the notifications service only.
MAILER_HOST=smtp.example.com
MAILER_PORT=587
MAILER_USERNAME=your_email@example.com
MAILER_FROM=noreply@example.com
MAILER_SMTP=smtp.example.com
MAILER_PASSWORD=your_email_password

# -- Message broker (Kafka) -----------------------------
# Shared: the API produces notification jobs to KAFKA_TOPIC; the notifier
# consumes them under KAFKA_GROUP_ID. Comma-separate KAFKA_BROKERS for a cluster.
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=notifications.events
KAFKA_DLQ_TOPIC=notifications.events.dlq
KAFKA_GROUP_ID=notifications-service
# Notifier only: transient-failure retries before a message is dead-lettered.
KAFKA_MAX_RETRIES=3

# -- Shared ---------------------------------------------
# Redis: API GitHub-response cache + notifier idempotency store (dedup markers).
REDIS_ADDRESS=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
# Notifier only: how long per-recipient dedup markers live (at-most-once window).
DEDUP_TTL=168h

# -- Postgres container ---------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gh-subscriptions
